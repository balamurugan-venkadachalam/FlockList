{
  "name": "family-task-manager",
  "version": "1.0.0",
  "description": "A flock task management application similar to Any.do",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "start:frontend": "cd frontend && npm start",
    "start:backend": "cd backend && npm start",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm test",
    "test:backend": "vitest",
    "test:unit": "vitest --include **/*.unit.test.ts",
    "test:integration": "vitest --include **/*.integration.test.ts",
    "test:watch": "vitest --watch",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "clean": "npm run clean:frontend && npm run clean:backend",
    "clean:frontend": "cd frontend && npm run clean",
    "clean:backend": "cd backend && npm run clean"
  },
  "devDependencies": {
    "@types/luxon": "^3.6.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "typescript": "^5.2.2",
    "vitest": "^1.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@types/aws-sdk": "^0.0.42",
    "@types/multer": "^1.4.12",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "aws-sdk": "^2.1692.0",
    "js-yaml": "^4.1.0",
    "luxon": "^3.6.1",
    "node-cron": "^3.0.3",
    "node-mailjet": "^6.0.5",
    "uuid": "^11.1.0"
  }
}
