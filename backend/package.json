{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/app.js",
  "private": true,
  "scripts": {
    "start": "node dist/app.js",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/app.ts",
    "dev:debug": "cross-env NODE_ENV=development ts-node-dev --inspect --respawn --transpile-only -r tsconfig-paths/register src/app.ts",
    "dev:kill": "pkill -f 'ts-node-dev.*src/app.ts' || true",
    "port:kill": "lsof -ti:3001 | xargs kill -9 2>/dev/null || true",
    "port:reset": "npm run dev:kill && npm run port:kill && sleep 1",
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "clean": "rm -rf node_modules dist coverage .nyc_output logs/*.log",
    "api:validate": "node scripts/validate-openapi.js",
    "api:serve": "swagger-ui-express -e openapi.yaml",
    "api:generate": "npx redoc-cli bundle openapi.yaml -o docs/api.html",
    "api:bundle": "npm run api:validate && npm run api:generate",
    "precommit": "npm run api:validate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@apidevtools/swagger-parser": "^10.1.1",
    "@google-cloud/storage": "^7.16.0",
    "@langchain/openai": "^0.5.11",
    "@types/multer": "^1.4.12",
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.21.2",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.0",
    "langchain": "^0.3.27",
    "mongoose": "^7.0.3",
    "multer": "^1.4.5-lts.2",
    "node-mailjet": "^6.0.5",
    "oci-sdk": "^2.107.1",
    "swagger-ui-express": "^4.6.3",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.13",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.21",
    "@types/express-validator": "^2.20.33",
    "@types/helmet": "^0.0.48",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^18.15.11",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitest/coverage-v8": "^3.1.1",
    "colors": "^1.4.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "glob": "^10.3.10",
    "husky": "^8.0.3",
    "js-yaml": "^4.1.0",
    "mongodb-memory-server": "^10.1.4",
    "redoc-cli": "^0.13.21",
    "supertest": "^6.3.4",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.3",
    "vitest": "^3.1.1"
  }
}
